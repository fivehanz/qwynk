<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 — No such link</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
  </head>
  <body class="bg-base-100 text-base-content">
    <main class="flex min-h-screen flex-col items-center justify-center gap-4 px-6 text-center">
      <p class="font-mono text-xs uppercase tracking-widest text-primary">Status: 404</p>
      <h1 class="text-4xl font-bold md:text-6xl">No such link.</h1>
      <p class="max-w-md font-mono text-sm opacity-60">
        This slug was never issued, or it has been disabled.
      </p>
    </main>
  </body>
</html>
